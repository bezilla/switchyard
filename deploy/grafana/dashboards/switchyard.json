{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic by provider",
      "description": "Successful requests per second, stacked. This is the panel `make break-apex` moves: the apex band collapses and the bargain band rises to meet the same total. A total that dips is availability being lost, not traffic being rerouted.",
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prom"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (rate(switchyard_requests_total{outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{provider}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 35,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (SLO 99.5%)",
      "description": "Fraction of counted requests that completed, over five minutes. Requests the caller canceled are excluded from both sides: the caller hanging up is not the gateway failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prom"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prom"
          },
          "editorMode": "code",
          "expr": "sum(rate(switchyard_requests_total{outcome=\"success\"}[5m])) / clamp_min(sum(rate(switchyard_requests_total{outcome=~\"success|no_provider|stream_error\"}[5m])), 0.0001)",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "valueSize": 42
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget burn rate",
      "description": "Multiples of the sustainable error rate. 1 means the 0.5% budget is being spent exactly as fast as it accrues; 14 means a month of budget is gone in about two days. Zero is the normal reading, and holding it at zero through a provider outage is the entire claim this project makes.",
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prom"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prom"
          },
          "editorMode": "code",
          "expr": "(1 - (sum(rate(switchyard_requests_total{outcome=\"success\"}[5m])) / clamp_min(sum(rate(switchyard_requests_total{outcome=~\"success|no_provider|stream_error\"}[5m])), 0.0001))) / 0.005",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "text": {
          "valueSize": 42
        }
      }
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Circuit breaker state",
      "description": "Closed passes everything, open passes nothing, recovering passes a growing fraction. The yellow band between red and green is the gradual recovery, and its width is the difference between coming back and coming back twice.",
      "datasource": {
        "type": "prometheus",
        "uid": "switchyard-prom"
      },
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "switchyard-prom"
          },
          "editorMode": "code",
          "expr": "switchyard_breaker_state",
          "legendFormat": "{{provider}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": true,
            "insertNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "recovering",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "open",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
